# Azure App Registration (required, no default) - see README for setup steps
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
SENDER_EMAIL=

# Sending pace / deliverability protection
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=180
MAX_EMAILS_PER_DAY=40

# Follow-up timing
FOLLOWUP_1_DAYS=1
FOLLOWUP_2_DAYS=3

# Background worker poll interval
WORKER_INTERVAL_SECONDS=300

# Optional: public base URL for open tracking (e.g. an ngrok HTTPS URL).
# Leave blank to disable open tracking entirely.
PUBLIC_BASE_URL=

# Flask server port
PORT=5000
